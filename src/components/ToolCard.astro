---
export interface Props {
  title: string;
  description: string;
  href: string;
  badge?: string;
  icon: 'cep' | 'cnpj' | 'currency' | 'calendar';
}

const { title, description, href, badge, icon } = Astro.props;
---

<a
  href={href}
  class="group bg-white rounded-2xl border border-slate-200 p-5 sm:p-6 hover:shadow-md hover:border-sky-300 transition-all flex flex-col justify-between"
>
  <div>
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center group-hover:bg-sky-600 group-hover:text-white transition-colors">
        {icon === 'cep' && (
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        )}
        {icon === 'cnpj' && (
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M3 9h18M9 21V9"></path>
          </svg>
        )}
        {icon === 'currency' && (
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="8"></circle>
            <line x1="12" y1="2" x2="12" y2="4"></line>
            <line x1="12" y1="20" x2="12" y2="22"></line>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
        )}
        {icon === 'calendar' && (
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        )}
      </div>

      {badge && (
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-sky-50 text-sky-700 border border-sky-100">
          {badge}
        </span>
      )}
    </div>

    <h3 class="text-lg font-bold text-slate-900 group-hover:text-sky-600 transition-colors mb-2">
      {title}
    </h3>

    <p class="text-sm text-slate-600 leading-relaxed">
      {description}
    </p>
  </div>

  <div class="mt-4 pt-3 flex items-center gap-1.5 text-xs font-semibold text-sky-600 group-hover:translate-x-1 transition-transform">
    <span>Acessar ferramenta</span>
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M5 12h14M12 5l7 7-7 7"></path>
    </svg>
  </div>
</a>
