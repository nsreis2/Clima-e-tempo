---
import { CITIES } from '../data/cities';

export interface Props {
  placeholder?: string;
  isHero?: boolean;
}

const { placeholder = 'Digite sua cidade (ex: Porto Alegre, RS)...', isHero = false } = Astro.props;

// Pass cities JSON safely to client script
const citiesJson = JSON.stringify(
  CITIES.map((c) => ({
    name: c.name,
    uf: c.uf,
    slug: c.slug,
    region: c.region,
  }))
);
---

<div class={`w-full relative search-city-container ${isHero ? 'max-w-2xl mx-auto' : 'max-w-md'}`}>
  <form id="search-city-form" class="relative flex items-center shadow-lg shadow-sky-900/5 rounded-2xl bg-white border border-slate-200 focus-within:border-sky-500 focus-within:ring-2 focus-within:ring-sky-200 transition-all">
    <div class="pl-4 pr-2 text-slate-400">
      <svg class="w-5 h-5 text-sky-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
    </div>

    <input
      type="text"
      id="city-search-input"
      name="cidade"
      autocomplete="off"
      placeholder={placeholder}
      class="w-full py-3.5 sm:py-4 px-2 text-base text-slate-800 placeholder-slate-400 bg-transparent rounded-2xl focus:outline-none"
      aria-label="Pesquisar previsão do tempo por cidade"
    />

    <button
      type="submit"
      class="mr-2 px-4 py-2 sm:py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold text-sm rounded-xl transition-colors shadow-xs shrink-0 cursor-pointer"
    >
      Buscar
    </button>
  </form>

  <!-- Autocomplete dropdown suggestions -->
  <div
    id="search-suggestions"
    class="hidden absolute left-0 right-0 top-full mt-2 bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden z-50 divide-y divide-slate-100 max-h-80 overflow-y-auto"
  >
    <!-- Dynamic Results -->
  </div>

  <!-- Recent Cities (from LocalStorage) & Popular Suggestions -->
  <div class="mt-3 flex flex-wrap items-center gap-1.5 text-xs text-slate-500" id="quick-cities-container">
    <span class="font-medium mr-1 text-slate-400">Cidades frequentes:</span>
    <a href="/clima/porto-alegre-rs" class="px-2.5 py-1 rounded-full bg-white border border-slate-200 text-slate-700 hover:border-sky-300 hover:text-sky-700 transition-colors">Porto Alegre, RS</a>
    <a href="/clima/sao-paulo-sp" class="px-2.5 py-1 rounded-full bg-white border border-slate-200 text-slate-700 hover:border-sky-300 hover:text-sky-700 transition-colors">São Paulo, SP</a>
    <a href="/clima/rio-de-janeiro-rj" class="px-2.5 py-1 rounded-full bg-white border border-slate-200 text-slate-700 hover:border-sky-300 hover:text-sky-700 transition-colors">Rio de Janeiro, RJ</a>
    <a href="/clima/curitiba-pr" class="px-2.5 py-1 rounded-full bg-white border border-slate-200 text-slate-700 hover:border-sky-300 hover:text-sky-700 transition-colors">Curitiba, PR</a>
    <a href="/clima/brasilia-df" class="px-2.5 py-1 rounded-full bg-white border border-slate-200 text-slate-700 hover:border-sky-300 hover:text-sky-700 transition-colors">Brasília, DF</a>
  </div>
</div>

<script define:vars={{ citiesJson }}>
  const cities = JSON.parse(citiesJson);
  const input = document.getElementById('city-search-input');
  const suggestionsBox = document.getElementById('search-suggestions');
  const form = document.getElementById('search-city-form');

  const RECENT_KEY = 'climabrasil_recent_cities';

  function saveRecentCity(city) {
    try {
      const recents = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
      const filtered = recents.filter((c) => c.slug !== city.slug);
      filtered.unshift(city);
      localStorage.setItem(RECENT_KEY, JSON.stringify(filtered.slice(0, 5)));
    } catch (e) {
      // Ignora erro de localStorage desabilitado
    }
  }

  function normalize(str) {
    return str
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();
  }

  function renderSuggestions(query) {
    if (!suggestionsBox) return;
    const q = normalize(query);

    if (q.length < 1) {
      suggestionsBox.classList.add('hidden');
      suggestionsBox.innerHTML = '';
      return;
    }

    const matches = cities.filter((c) => {
      const name = normalize(c.name);
      const uf = c.uf.toLowerCase();
      return name.includes(q) || uf === q || `${name} ${uf}`.includes(q);
    }).slice(0, 6);

    if (matches.length === 0) {
      suggestionsBox.innerHTML = `
        <div class="p-4 text-center text-sm text-slate-500">
          Nenhuma cidade encontrada para "<strong>${query}</strong>".<br />
          <span class="text-xs text-slate-400">Tente buscar por capitais ou cidades metropolitanas.</span>
        </div>
      `;
      suggestionsBox.classList.remove('hidden');
      return;
    }

    suggestionsBox.innerHTML = matches
      .map(
        (c) => `
        <a
          href="/clima/${c.slug}"
          class="flex items-center justify-between px-4 py-3 hover:bg-sky-50/80 transition-colors cursor-pointer group"
          data-slug="${c.slug}"
          data-name="${c.name}"
          data-uf="${c.uf}"
        >
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-sky-100 text-sky-700 flex items-center justify-center text-xs font-bold group-hover:bg-sky-600 group-hover:text-white transition-colors">
              ${c.uf}
            </span>
            <div>
              <p class="text-sm font-semibold text-slate-900 group-hover:text-sky-700">
                ${c.name}
              </p>
              <p class="text-xs text-slate-400">Região ${c.region}</p>
            </div>
          </div>
          <span class="text-xs text-sky-600 font-medium">Ver clima →</span>
        </a>
      `
      )
      .join('');

    suggestionsBox.classList.remove('hidden');

    // Click listener to save to recent
    suggestionsBox.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', (e) => {
        const slug = link.getAttribute('data-slug');
        const name = link.getAttribute('data-name');
        const uf = link.getAttribute('data-uf');
        if (slug && name && uf) {
          saveRecentCity({ slug, name, uf });
        }
      });
    });
  }

  if (input && suggestionsBox && form) {
    input.addEventListener('input', (e) => {
      renderSuggestions(e.target.value);
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!form.contains(e.target) && !suggestionsBox.contains(e.target)) {
        suggestionsBox.classList.add('hidden');
      }
    });

    // Form submit redirects to best match
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = input.value.trim();
      if (!val) return;

      const q = normalize(val);
      const match = cities.find((c) => {
        const name = normalize(c.name);
        const uf = c.uf.toLowerCase();
        return name === q || `${name} ${uf}` === q || name.includes(q);
      });

      if (match) {
        saveRecentCity(match);
        window.location.href = `/clima/${match.slug}`;
      } else {
        // Fallback or local slug
        const slug = q.replace(/[^a-z0-9]/g, '-');
        window.location.href = `/clima/${slug}`;
      }
    });
  }
</script>
