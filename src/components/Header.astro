---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/clima', label: 'Clima' },
  { href: '/alertas', label: 'Alertas' },
  { href: '/noticias', label: 'Notícias' },
  { href: '/el-nino', label: 'El Niño' },
  { href: '/ferramentas', label: 'Ferramentas' },
];
---

<header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500 rounded-lg p-1">
        <span class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-600 to-amber-500 flex items-center justify-center text-white shadow-sm shadow-sky-200 group-hover:scale-105 transition-transform">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="M20 12h2"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
            <path d="M15.947 12.65a4 4 0 0 0-5.925-4.128 4 4 0 0 0-6.02 4.478 3.5 3.5 0 0 0 0 7H16a4 4 0 0 0 0-8c-.018 0-.035.001-.053.003z"></path>
          </svg>
        </span>
        <div class="flex flex-col">
          <span class="text-xl font-bold tracking-tight text-slate-900 group-hover:text-sky-700 transition-colors">
            Clima<span class="text-sky-600">Brasil</span>
          </span>
          <span class="text-[10px] uppercase font-semibold tracking-wider text-slate-400 -mt-1">
            Tempo & Utilidades
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-1" aria-label="Navegação Principal">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors ${
                isActive
                  ? 'bg-sky-50 text-sky-700 font-semibold'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
              }`}
            >
              {item.label}
              {item.href === '/alertas' && (
                <span class="ml-1.5 inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                  Avisos
                </span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Search quick jump or direct city link -->
      <div class="hidden sm:flex items-center gap-2">
        <a
          href="/clima"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-sky-700 bg-sky-50 border border-sky-200 rounded-lg hover:bg-sky-100 transition-colors"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          Buscar Cidade
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden">
        <button
          type="button"
          id="mobile-menu-btn"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-sky-500"
        >
          <span class="sr-only">Abrir menu</span>
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-2 pb-4 space-y-1">
    {navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`block px-3 py-2 rounded-md text-base font-medium ${
            isActive
              ? 'bg-sky-50 text-sky-700 font-bold'
              : 'text-slate-700 hover:text-slate-900 hover:bg-slate-100'
          }`}
        >
          {item.label}
        </a>
      );
    })}
    <div class="pt-2 border-t border-slate-100">
      <a
        href="/ferramentas/cep"
        class="block px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 rounded-md"
      >
        Consulta CEP
      </a>
      <a
        href="/ferramentas/cnpj"
        class="block px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 rounded-md"
      >
        Consulta CNPJ
      </a>
      <a
        href="/ferramentas/moedas"
        class="block px-3 py-2 text-sm text-slate-600 hover:bg-slate-50 rounded-md"
      >
        Conversor de Moedas
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const close = document.getElementById('close-icon');

  if (btn && menu && hamburger && close) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      hamburger.classList.toggle('hidden');
      close.classList.toggle('hidden');
    });
  }
</script>
