---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdPlaceholder from '../../components/AdPlaceholder.astro';
import { buildWebApplicationSchema } from '../../utils/seo';

const breadcrumbs = [
  { name: 'Início', url: '/' },
  { name: 'Ferramentas', url: '/ferramentas' },
  { name: 'Consulta CNPJ', url: '/ferramentas/cnpj' },
];

const schema = buildWebApplicationSchema({
  name: 'Consulta de CNPJ - ClimaBrasil',
  description: 'Consulte dados públicos de empresas brasileiras pelo CNPJ.',
  url: 'https://climabrasil.com.br/ferramentas/cnpj',
  applicationCategory: 'UtilityApplication',
});
---

<BaseLayout
  title="Consulta de CNPJ - Dados Públicos de Empresas"
  description="Consulte a situação cadastral, razão social, atividade econômica e endereço de qualquer empresa brasileira pelo CNPJ. Gratuito e sem cadastro."
  schema={schema}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="max-w-2xl mx-auto py-6">
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
      Consulta de CNPJ
    </h1>
    <p class="mt-2 text-sm text-slate-600 mb-6">
      Consulte dados públicos de empresas brasileiras. Fonte: Receita Federal via BrasilAPI.
    </p>

    <form id="cnpj-form" class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs">
      <label for="cnpj-input" class="block text-sm font-semibold text-slate-700 mb-2">CNPJ</label>
      <div class="flex gap-3">
        <input
          type="text"
          id="cnpj-input"
          name="cnpj"
          placeholder="00.000.000/0000-00"
          maxlength="18"
          inputmode="numeric"
          class="flex-1 px-4 py-3 border border-slate-300 rounded-xl text-base focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500"
          aria-label="Digite o CNPJ"
          required
        />
        <button type="submit" class="px-6 py-3 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-xl transition-colors shadow-xs cursor-pointer">
          Consultar
        </button>
      </div>
    </form>

    <div id="cnpj-loading" class="hidden mt-4 text-center text-sm text-slate-500 animate-pulse">Consultando CNPJ...</div>
    <div id="cnpj-error" class="hidden mt-4 p-4 rounded-xl bg-rose-50 border border-rose-200 text-sm text-rose-800"></div>

    <div id="cnpj-result" class="hidden mt-6 bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-3">
      <h2 class="text-lg font-bold text-slate-900 mb-3">Dados da Empresa</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
        <div class="bg-slate-50 p-3 rounded-xl sm:col-span-2">
          <span class="text-xs text-slate-400 font-medium block">Razão Social</span>
          <span id="res-razao" class="font-bold text-slate-800"></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl sm:col-span-2">
          <span class="text-xs text-slate-400 font-medium block">Nome Fantasia</span>
          <span id="res-fantasia" class="font-bold text-slate-800"></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl">
          <span class="text-xs text-slate-400 font-medium block">CNPJ</span>
          <span id="res-cnpj" class="font-bold text-slate-800"></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl">
          <span class="text-xs text-slate-400 font-medium block">Situação Cadastral</span>
          <span id="res-situacao" class="font-bold text-slate-800"></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl sm:col-span-2">
          <span class="text-xs text-slate-400 font-medium block">Atividade Principal (CNAE)</span>
          <span id="res-cnae" class="font-bold text-slate-800"></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl">
          <span class="text-xs text-slate-400 font-medium block">Município</span>
          <span id="res-municipio" class="font-bold text-slate-800"></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl">
          <span class="text-xs text-slate-400 font-medium block">UF</span>
          <span id="res-uf" class="font-bold text-slate-800"></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl">
          <span class="text-xs text-slate-400 font-medium block">Porte</span>
          <span id="res-porte" class="font-bold text-slate-800"></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl">
          <span class="text-xs text-slate-400 font-medium block">Capital Social</span>
          <span id="res-capital" class="font-bold text-slate-800"></span>
        </div>
      </div>
    </div>

    <AdPlaceholder slotType="horizontal" slotId="cnpj-bottom" className="mt-8" />

    <div class="mt-6 text-xs text-slate-500">
      <strong>Fonte:</strong> <a href="https://brasilapi.com.br" target="_blank" rel="noopener noreferrer" class="text-sky-600 hover:underline">BrasilAPI</a> — Dados públicos da Receita Federal.
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('cnpj-form') as HTMLFormElement;
  const input = document.getElementById('cnpj-input') as HTMLInputElement;
  const loading = document.getElementById('cnpj-loading')!;
  const errorDiv = document.getElementById('cnpj-error')!;
  const resultDiv = document.getElementById('cnpj-result')!;

  // CNPJ mask
  input.addEventListener('input', () => {
    let val = input.value.replace(/\D/g, '');
    if (val.length > 2) val = val.slice(0, 2) + '.' + val.slice(2);
    if (val.length > 6) val = val.slice(0, 6) + '.' + val.slice(6);
    if (val.length > 10) val = val.slice(0, 10) + '/' + val.slice(10);
    if (val.length > 15) val = val.slice(0, 15) + '-' + val.slice(15, 17);
    input.value = val;
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const cnpj = input.value.replace(/\D/g, '');
    if (cnpj.length !== 14) {
      showError('O CNPJ deve conter exatamente 14 dígitos.');
      return;
    }

    loading.classList.remove('hidden');
    errorDiv.classList.add('hidden');
    resultDiv.classList.add('hidden');

    try {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 6000);
      const res = await fetch(`https://brasilapi.com.br/api/cnpj/v1/${cnpj}`, { signal: controller.signal });
      clearTimeout(timeout);

      if (res.status === 404) { showError('CNPJ não encontrado na base da Receita Federal.'); return; }
      if (res.status === 429) { showError('Limite de requisições excedido. Aguarde e tente novamente.'); return; }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const data = await res.json();

      const formatCnpj = (c: string) => c.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5');
      const formatCapital = (val: number) => val ? val.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) : 'Não informado';

      document.getElementById('res-razao')!.textContent = data.razao_social || 'Não informada';
      document.getElementById('res-fantasia')!.textContent = data.nome_fantasia || 'Não informado';
      document.getElementById('res-cnpj')!.textContent = formatCnpj(data.cnpj || cnpj);
      document.getElementById('res-situacao')!.textContent = data.descricao_situacao_cadastral || 'ATIVA';
      document.getElementById('res-cnae')!.textContent = data.cnae_fiscal_descricao || 'Não informada';
      document.getElementById('res-municipio')!.textContent = data.municipio || '';
      document.getElementById('res-uf')!.textContent = data.uf || '';
      document.getElementById('res-porte')!.textContent = data.porte || 'Não informado';
      document.getElementById('res-capital')!.textContent = formatCapital(data.capital_social);

      resultDiv.classList.remove('hidden');
    } catch (err: any) {
      if (err.name === 'AbortError') showError('Tempo limite excedido.');
      else showError('Erro ao consultar o CNPJ. Verifique sua conexão.');
    } finally {
      loading.classList.add('hidden');
    }
  });

  function showError(msg: string) {
    errorDiv.textContent = msg;
    errorDiv.classList.remove('hidden');
    resultDiv.classList.add('hidden');
    loading.classList.add('hidden');
  }
</script>
