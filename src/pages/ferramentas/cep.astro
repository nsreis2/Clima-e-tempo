---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdPlaceholder from '../../components/AdPlaceholder.astro';
import { buildWebApplicationSchema } from '../../utils/seo';

const breadcrumbs = [
  { name: 'Início', url: '/' },
  { name: 'Ferramentas', url: '/ferramentas' },
  { name: 'Consulta CEP', url: '/ferramentas/cep' },
];

const schema = buildWebApplicationSchema({
  name: 'Consulta de CEP - ClimaBrasil',
  description: 'Ferramenta gratuita para consultar endereços pelo CEP dos Correios via ViaCEP.',
  url: 'https://climabrasil.com.br/ferramentas/cep',
  applicationCategory: 'UtilityApplication',
});
---

<BaseLayout
  title="Consulta de CEP - Busca de Endereço Gratuita"
  description="Consulte qualquer CEP do Brasil e encontre o endereço completo com logradouro, bairro, cidade e estado. Gratuito, sem cadastro."
  schema={schema}
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="max-w-2xl mx-auto py-6">
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
      Consulta de CEP
    </h1>
    <p class="mt-2 text-sm text-slate-600 mb-6">
      Digite um CEP válido para localizar o endereço completo. Dados oficiais dos Correios via ViaCEP.
    </p>

    <!-- Formulário -->
    <form id="cep-form" class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs">
      <label for="cep-input" class="block text-sm font-semibold text-slate-700 mb-2">
        CEP
      </label>
      <div class="flex gap-3">
        <input
          type="text"
          id="cep-input"
          name="cep"
          placeholder="00000-000"
          maxlength="9"
          inputmode="numeric"
          autocomplete="postal-code"
          class="flex-1 px-4 py-3 border border-slate-300 rounded-xl text-base focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500"
          aria-label="Digite o CEP"
          required
        />
        <button
          type="submit"
          id="cep-submit"
          class="px-6 py-3 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-xl transition-colors shadow-xs cursor-pointer"
        >
          Consultar
        </button>
      </div>
    </form>

    <!-- Loading -->
    <div id="cep-loading" class="hidden mt-4 text-center text-sm text-slate-500 animate-pulse">
      Consultando CEP...
    </div>

    <!-- Erro -->
    <div id="cep-error" class="hidden mt-4 p-4 rounded-xl bg-rose-50 border border-rose-200 text-sm text-rose-800">
    </div>

    <!-- Resultado -->
    <div id="cep-result" class="hidden mt-6 bg-white rounded-2xl border border-slate-200 p-6 shadow-xs space-y-3">
      <h2 class="text-lg font-bold text-slate-900 mb-3">Resultado da Consulta</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
        <div class="bg-slate-50 p-3 rounded-xl">
          <span class="text-xs text-slate-400 font-medium block">CEP</span>
          <span id="res-cep" class="font-bold text-slate-800"></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl">
          <span class="text-xs text-slate-400 font-medium block">UF</span>
          <span id="res-uf" class="font-bold text-slate-800"></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl sm:col-span-2">
          <span class="text-xs text-slate-400 font-medium block">Logradouro</span>
          <span id="res-logradouro" class="font-bold text-slate-800"></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl">
          <span class="text-xs text-slate-400 font-medium block">Bairro</span>
          <span id="res-bairro" class="font-bold text-slate-800"></span>
        </div>
        <div class="bg-slate-50 p-3 rounded-xl">
          <span class="text-xs text-slate-400 font-medium block">Cidade</span>
          <span id="res-cidade" class="font-bold text-slate-800"></span>
        </div>
      </div>
      <div class="pt-3 border-t border-slate-100">
        <button
          id="cep-copy"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2 bg-sky-50 text-sky-700 font-semibold text-sm rounded-lg border border-sky-200 hover:bg-sky-100 transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
          Copiar endereço
        </button>
      </div>
    </div>

    <AdPlaceholder slotType="horizontal" slotId="cep-bottom" className="mt-8" />

    <div class="mt-6 text-xs text-slate-500">
      <strong>Fonte:</strong> <a href="https://viacep.com.br" target="_blank" rel="noopener noreferrer" class="text-sky-600 hover:underline">ViaCEP</a> — Webservice gratuito de consulta de CEP dos Correios.
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('cep-form') as HTMLFormElement;
  const input = document.getElementById('cep-input') as HTMLInputElement;
  const loading = document.getElementById('cep-loading')!;
  const errorDiv = document.getElementById('cep-error')!;
  const resultDiv = document.getElementById('cep-result')!;
  const copyBtn = document.getElementById('cep-copy')!;

  let fullAddress = '';

  // CEP mask
  input.addEventListener('input', () => {
    let val = input.value.replace(/\D/g, '');
    if (val.length > 5) val = val.slice(0, 5) + '-' + val.slice(5, 8);
    input.value = val;
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const cep = input.value.replace(/\D/g, '');
    if (cep.length !== 8) {
      showError('O CEP deve conter exatamente 8 dígitos.');
      return;
    }

    loading.classList.remove('hidden');
    errorDiv.classList.add('hidden');
    resultDiv.classList.add('hidden');

    try {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 5000);
      const res = await fetch(`https://viacep.com.br/ws/${cep}/json/`, { signal: controller.signal });
      clearTimeout(timeout);

      if (!res.ok) throw new Error('Erro na requisição');

      const data = await res.json();

      if (data.erro) {
        showError('CEP não encontrado na base dos Correios.');
        return;
      }

      (document.getElementById('res-cep')!).textContent = data.cep || '';
      (document.getElementById('res-logradouro')!).textContent = data.logradouro || 'Não especificado';
      (document.getElementById('res-bairro')!).textContent = data.bairro || 'Não especificado';
      (document.getElementById('res-cidade')!).textContent = data.localidade || '';
      (document.getElementById('res-uf')!).textContent = data.uf || '';

      fullAddress = [data.logradouro, data.bairro, `${data.localidade} - ${data.uf}`, `CEP ${data.cep}`].filter(Boolean).join(', ');

      resultDiv.classList.remove('hidden');
    } catch (err: any) {
      if (err.name === 'AbortError') {
        showError('Tempo limite excedido. Tente novamente.');
      } else {
        showError('Não foi possível consultar o CEP. Verifique sua conexão.');
      }
    } finally {
      loading.classList.add('hidden');
    }
  });

  copyBtn.addEventListener('click', async () => {
    if (!fullAddress) return;
    try {
      await navigator.clipboard.writeText(fullAddress);
      copyBtn.textContent = '✓ Copiado!';
      setTimeout(() => {
        copyBtn.innerHTML = '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg> Copiar endereço';
      }, 2000);
    } catch {
      // fallback
    }
  });

  function showError(msg: string) {
    errorDiv.textContent = msg;
    errorDiv.classList.remove('hidden');
    resultDiv.classList.add('hidden');
    loading.classList.add('hidden');
  }
</script>
