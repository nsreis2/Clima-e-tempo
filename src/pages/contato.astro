---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdPlaceholder from '../components/AdPlaceholder.astro';

const breadcrumbs = [
  { name: 'Início', url: '/' },
  { name: 'Contato', url: '/contato' },
];
---

<BaseLayout
  title="Fale Conosco - Atendimento e Sugestões | ClimaBrasil"
  description="Entre em contato com a equipe editorial e técnica do ClimaBrasil para dúvidas, sugestões, reporte de inconsistências em dados ou propostas de parceria."
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="max-w-3xl mx-auto py-6">
    <div class="mb-8">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-sky-100 text-sky-800 mb-2">
        Atendimento
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        Fale Conosco
      </h1>
      <p class="mt-2 text-base text-slate-600">
        Tem alguma sugestão de melhoria, identificou uma inconsistência de dados ou deseja propor uma parceria? Estamos à disposição.
      </p>
    </div>

    <AdPlaceholder slotType="horizontal" slotId="contato-top" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
      <!-- Card E-mail Principal -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-sky-50 text-sky-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">Contato Editorial</h2>
          <p class="text-sm text-slate-600 leading-relaxed mb-4">
            Para sugestões de pautas, correções em resumos de notícias ou esclarecimentos sobre publicações.
          </p>
        </div>
        <div>
          <span class="text-xs text-slate-400 block mb-1">E-mail direto:</span>
          <a
            href="mailto:contato@climabrasil.com.br"
            class="text-base font-bold text-sky-600 hover:text-sky-700 underline"
          >
            contato@climabrasil.com.br
          </a>
        </div>
      </div>

      <!-- Card Suporte Técnico e Ferramentas -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">Suporte às Ferramentas</h2>
          <p class="text-sm text-slate-600 leading-relaxed mb-4">
            Para relatar instabilidade técnica na consulta de CEP, CNPJ, moedas ou previsão de alguma cidade específica.
          </p>
        </div>
        <div>
          <span class="text-xs text-slate-400 block mb-1">Tempo médio de resposta:</span>
          <span class="text-sm font-semibold text-slate-700">Até 48 horas úteis</span>
        </div>
      </div>
    </div>

    <!-- Orientações Úteis -->
    <div class="bg-slate-50 rounded-2xl p-6 border border-slate-200 text-xs text-slate-600 space-y-2">
      <h3 class="font-bold text-slate-900 text-sm mb-2">Orientações de Atendimento:</h3>
      <p>• <strong>Emergências Climáticas:</strong> Se você estiver enfrentando enchentes, deslizamentos ou risco iminente, contate imediatamente a <strong>Defesa Civil (199)</strong> ou o <strong>Corpo de Bombeiros (193)</strong>. O ClimaBrasil é um portal informativo e não realiza atendimento emergencial.</p>
      <p>• <strong>Direitos Autorais e Notificações:</strong> Caso seja titular de algum conteúdo e identifique necessidade de ajuste ou remoção de link referenciado, envie os dados da URL correspondente para o nosso e-mail.</p>
    </div>

    <AdPlaceholder slotType="horizontal" slotId="contato-bottom" className="mt-8" />
  </section>
</BaseLayout>
