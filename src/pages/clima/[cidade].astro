---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeatherCard from '../../components/WeatherCard.astro';
import ForecastCard from '../../components/ForecastCard.astro';
import HourlyForecast from '../../components/HourlyForecast.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdPlaceholder from '../../components/AdPlaceholder.astro';
import { CITIES, getCityBySlug } from '../../data/cities';
import { fetchWeather } from '../../services/weather/api';
import { buildWeatherSchema } from '../../utils/seo';

export async function getStaticPaths() {
  return CITIES.map((city) => ({
    params: { cidade: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const weather = await fetchWeather(city.latitude, city.longitude, city.name, city.uf);

// Nearby cities objects
const nearbyCitiesList = city.nearbyCities
  .map((slug) => getCityBySlug(slug))
  .filter((c): c is typeof city => Boolean(c));

const breadcrumbs = [
  { name: 'Início', url: '/' },
  { name: 'Clima', url: '/clima' },
  { name: `${city.name} - ${city.uf}`, url: `/clima/${city.slug}` },
];

const pageTitle = `Previsão do Tempo em ${city.name} - ${city.uf} Hoje e Próximos Dias`;
const metaDescription = `Veja a previsão do tempo para ${city.name} (${city.uf}). Temperatura atual de ${weather.current.temperature}°C, sensação térmica de ${weather.current.apparentTemperature}°C, probabilidade de chuva, vento e previsão de 7 dias.`;

const weatherSchema = buildWeatherSchema({
  cityName: city.name,
  stateUf: city.uf,
  temperature: weather.current.temperature,
  condition: weather.current.conditionText,
  minTemp: weather.today.minTemp,
  maxTemp: weather.today.maxTemp,
  url: `https://climabrasil.com.br/clima/${city.slug}`,
  date: new Date().toISOString(),
});
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  schema={weatherSchema}
>
  <Breadcrumbs items={breadcrumbs} />

  <!-- H1 Principal exigido no prompt: Previsão do tempo em [Cidade] - [UF] -->
  <header class="mb-6">
    <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
      Previsão do tempo em {city.name} - {city.uf}
    </h1>
    <p class="text-sm text-slate-500 mt-1">
      Condições meteorológicas em tempo real, evolução hora a hora e previsão para os próximos 7 dias.
    </p>
  </header>

  <div class="space-y-6">
    <!-- Card Principal de Clima -->
    <WeatherCard weather={weather} />

    <!-- Anúncio Horizontal entre conteúdo -->
    <AdPlaceholder slotType="horizontal" slotId={`city-${city.slug}-top`} />

    <!-- Previsão Hora a Hora -->
    <HourlyForecast hourly={weather.hourly} />

    <!-- Previsão dos Próximos 7 Dias -->
    <ForecastCard daily={weather.daily} />

    <!-- Explicação do Clima Local e Características Regionais -->
    <section class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-xs">
      <h2 class="text-xl font-bold text-slate-900 mb-4">
        Sobre o Clima em {city.name} ({city.uf})
      </h2>
      <div class="prose prose-slate max-w-none text-slate-600 text-sm leading-relaxed space-y-3">
        <p>
          {city.description}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-100">
          <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/60">
            <span class="text-xs text-slate-400 font-medium block">Tipo Climático</span>
            <span class="text-sm font-bold text-slate-800">{city.climateType}</span>
          </div>
          <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/60">
            <span class="text-xs text-slate-400 font-medium block">Temperatura Média Anual</span>
            <span class="text-sm font-bold text-slate-800">{city.averageAnnualTemp}°C</span>
          </div>
          <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/60">
            <span class="text-xs text-slate-400 font-medium block">Regime de Chuvas</span>
            <span class="text-sm font-bold text-slate-800">{city.rainySeason}</span>
          </div>
        </div>
      </div>
      <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-400">
        <span>Última atualização dos dados: <strong>{weather.lastUpdated}</strong></span>
        <span>Fonte: <strong>{weather.dataSource}</strong></span>
      </div>
    </section>

    <!-- Cidades Relacionadas / Vizinhas -->
    {nearbyCitiesList.length > 0 && (
      <section class="pt-4">
        <h2 class="text-lg font-bold text-slate-900 mb-3">
          Previsão em Cidades Vizinhas e Região
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
          {nearbyCitiesList.map((near) => (
            <a
              href={`/clima/${near.slug}`}
              class="p-3 bg-white rounded-xl border border-slate-200 hover:border-sky-300 hover:shadow-xs transition-all text-center group"
            >
              <span class="text-xs font-bold text-sky-700 block mb-0.5">
                {near.uf}
              </span>
              <span class="text-sm font-semibold text-slate-800 group-hover:text-sky-600 transition-colors">
                {near.name}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Anúncio Horizontal inferior -->
    <AdPlaceholder slotType="horizontal" slotId={`city-${city.slug}-bottom`} />
  </div>
</BaseLayout>
