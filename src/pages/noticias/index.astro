---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdPlaceholder from '../../components/AdPlaceholder.astro';
import { NEWS_ITEMS } from '../../data/news';

const breadcrumbs = [
  { name: 'Início', url: '/' },
  { name: 'Notícias', url: '/noticias' },
];

const categories = [
  { slug: 'todos', label: 'Todas as Notícias', href: '/noticias' },
  { slug: 'clima', label: 'Clima & Tempo', href: '/noticias/clima' },
  { slug: 'brasil', label: 'Brasil', href: '/noticias/brasil' },
  { slug: 'mundo', label: 'Mundo', href: '/noticias/mundo' },
];

const featuredNews = NEWS_ITEMS[0];
const remainingNews = NEWS_ITEMS.slice(1);
---

<BaseLayout
  title="Notícias sobre Clima, Tempo, Meio Ambiente e Brasil"
  description="Acompanhe as últimas notícias e boletins sobre clima, ondas de calor, frentes frias, chuvas, meio ambiente e acontecimentos relevantes no Brasil e no mundo."
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="max-w-7xl mx-auto py-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-slate-200">
      <div>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
          Notícias & Boletins
        </h1>
        <p class="mt-2 text-base text-slate-600">
          Informações apuradas de fontes oficiais sobre clima, sustentabilidade e acontecimentos do país.
        </p>
      </div>

      <!-- Category Filter Pills -->
      <nav class="flex flex-wrap items-center gap-2" aria-label="Categorias de notícias">
        {categories.map((cat, idx) => (
          <a
            href={cat.href}
            class={`px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors ${
              idx === 0
                ? 'bg-sky-600 text-white shadow-xs'
                : 'bg-white border border-slate-200 text-slate-700 hover:border-sky-300 hover:text-sky-700'
            }`}
          >
            {cat.label}
          </a>
        ))}
      </nav>
    </div>

    <AdPlaceholder slotType="horizontal" slotId="noticias-top" />

    <!-- Notícia em Destaque Principal -->
    {featuredNews && (
      <div class="my-8">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
          Destaque Editorial
        </h2>
        <div class="grid grid-cols-1">
          <NewsCard news={featuredNews} featured={true} />
        </div>
      </div>
    )}

    <!-- Grade de Notícias Restantes -->
    <div class="my-8">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">
        Outras Publicações Recentes
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {remainingNews.map((news) => (
          <NewsCard news={news} />
        ))}
      </div>
    </div>

    <AdPlaceholder slotType="horizontal" slotId="noticias-bottom" />
  </section>
</BaseLayout>
