---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdPlaceholder from '../../components/AdPlaceholder.astro';
import { getNewsByCategory } from '../../data/news';

const climaNews = getNewsByCategory('clima');

const breadcrumbs = [
  { name: 'Início', url: '/' },
  { name: 'Notícias', url: '/noticias' },
  { name: 'Clima', url: '/noticias/clima' },
];
---

<BaseLayout
  title="Notícias sobre Clima e Previsão do Tempo no Brasil"
  description="Fique por dentro das últimas notícias sobre clima, frentes frias, ondas de calor, alertas meteorológicos e mudanças no tempo em todas as regiões do Brasil."
>
  <Breadcrumbs items={breadcrumbs} />

  <section class="max-w-7xl mx-auto py-6">
    <div class="pb-6 border-b border-slate-200">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 mb-2">
        Categoria Editorial
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        Notícias de Clima & Tempo
      </h1>
      <p class="mt-2 text-base text-slate-600">
        Análises meteorológicas, frentes frias, boletins de precipitação e fenômenos atmosféricos no Brasil.
      </p>
    </div>

    <AdPlaceholder slotType="horizontal" slotId="noticias-clima-top" />

    <div class="my-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {climaNews.map((news) => (
        <NewsCard news={news} />
      ))}
    </div>

    <AdPlaceholder slotType="horizontal" slotId="noticias-clima-bottom" />
  </section>
</BaseLayout>
