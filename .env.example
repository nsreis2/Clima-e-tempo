# Variáveis de Ambiente - ClimaBrasil
# Copie este arquivo para .env e preencha os valores necessários

# === APIs de Clima ===
# Open-Meteo: API gratuita sem chave necessária
# Caso migre para uma API paga no futuro:
# WEATHER_API_KEY=

# === APIs de Notícias ===
# Caso integre uma API de notícias com autenticação:
# NEWS_API_KEY=

# === APIs de Câmbio ===
# AwesomeAPI: API gratuita sem chave necessária
# Caso migre para uma API paga:
# CURRENCY_API_KEY=

# === Google Analytics ===
# Insira seu ID de medição do Google Analytics 4 (GA4)
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# === Google AdSense ===
# Insira seu ID de cliente do Google AdSense
# PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# === Google Search Console ===
# Insira o código de verificação do Search Console
# PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Domínio do Site ===
# URL canônica para SEO e sitemap
SITE_URL=https://climabrasil.com.br
